{{!< layouts/main}}

<section class="relative bg-gradient-to-br from-yellow-50 via-white to-blue-100 py-20 px-4 min-h-[70vh] flex items-center">
  <div class="absolute inset-0 pointer-events-none">
    <svg class="absolute top-0 left-0 w-40 h-40 opacity-20" fill="none" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="100" fill="#FFD700"/>
    </svg>
    <svg class="absolute bottom-0 right-0 w-48 h-48 opacity-10" fill="none" viewBox="0 0 200 200">
      <rect width="200" height="200" rx="40" fill="#0F172A"/>
    </svg>
  </div>
  <div class="relative z-10 max-w-6xl mx-auto w-full flex flex-col md:flex-row items-center gap-10">
    <div class="flex-1 text-center md:text-left">
      <h2 class="text-4xl md:text-5xl font-extrabold mb-6 text-[#0F172A] drop-shadow-lg">
        Bienvenido a <span class="text-[#FFD700]">Importadora O-N</span>
      </h2>
      <p class="text-xl text-gray-700 mb-8 font-medium">
        Tu socio confiable en importación, ventas y distribución de productos de alta calidad para tu negocio o emprendimiento.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a href="/productos" class="bg-[#FFD700] hover:bg-yellow-400 text-[#0F172A] font-bold px-8 py-3 rounded shadow-lg transition-all duration-200 text-lg">
          Ver productos
        </a>
        <a href="/contacto" class="bg-white border border-[#FFD700] hover:bg-yellow-50 text-[#0F172A] font-semibold px-8 py-3 rounded shadow transition-all duration-200 text-lg">
          Contáctanos
        </a>
      </div>
    </div>
    <div class="flex-1 flex justify-center">
      <div class="bg-white/90 rounded-xl shadow-xl p-6 flex flex-col items-center">
        <img src="/images/logo-on.png" alt="Importadora O-N" class="w-40 h-40 mb-4 drop-shadow-lg">
        <h3 class="text-xl font-bold text-[#0F172A] mb-2">Soluciones Integrales</h3>
        <ul class="text-gray-700 text-base space-y-1 text-left">
          <li><i class="fas fa-check text-[#FFD700] mr-2"></i> Importación directa</li>
          <li><i class="fas fa-check text-[#FFD700] mr-2"></i> Distribución nacional</li>
          <li><i class="fas fa-check text-[#FFD700] mr-2"></i> Marcas reconocidas</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <h3 class="text-2xl font-bold text-center mb-10 text-[#0F172A]">Nuestros Productos Destacados</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-yellow-50 rounded-lg shadow p-6 flex flex-col items-center">
        <img src="/images/producto1.jpg" alt="Producto 1" class="w-32 h-32 object-cover rounded mb-4">
        <h4 class="font-bold text-lg mb-2">Producto Estrella</h4>
        <p class="text-gray-600 mb-4 text-center">Calidad y sabor garantizados para tu negocio.</p>
        <a href="/productos" class="text-[#FFD700] font-semibold hover:underline">Ver más</a>
      </div>
      <div class="bg-yellow-50 rounded-lg shadow p-6 flex flex-col items-center">
        <img src="/images/producto2.jpg" alt="Producto 2" class="w-32 h-32 object-cover rounded mb-4">
        <h4 class="font-bold text-lg mb-2">Nuevas Importaciones</h4>
        <p class="text-gray-600 mb-4 text-center">Siempre innovando con lo mejor del mercado internacional.</p>
        <a href="/productos" class="text-[#FFD700] font-semibold hover:underline">Ver más</a>
      </div>
      <div class="bg-yellow-50 rounded-lg shadow p-6 flex flex-col items-center">
        <img src="/images/producto3.jpg" alt="Producto 3" class="w-32 h-32 object-cover rounded mb-4">
        <h4 class="font-bold text-lg mb-2">Ofertas Especiales</h4>
        <p class="text-gray-600 mb-4 text-center">Aprovecha nuestros precios exclusivos por temporada.</p>
        <a href="/productos" class="text-[#FFD700] font-semibold hover:underline">Ver más</a>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-gradient-to-r from-[#FFD700]/10 via-white to-[#0F172A]/5">
  <div class="max-w-6xl mx-auto px-4">
    <h3 class="text-2xl font-bold text-center mb-10 text-[#0F172A]">¿Por qué elegirnos?</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="flex flex-col items-center">
        <i class="fas fa-shipping-fast text-4xl text-[#FFD700] mb-4"></i>
        <h4 class="font-bold mb-2">Envíos a todo el país</h4>
        <p class="text-gray-600 text-center">Llegamos a cada rincón de Bolivia con rapidez y seguridad.</p>
      </div>
      <div class="flex flex-col items-center">
        <i class="fas fa-award text-4xl text-[#FFD700] mb-4"></i>
        <h4 class="font-bold mb-2">Calidad Garantizada</h4>
        <p class="text-gray-600 text-center">Solo trabajamos con productos certificados y marcas reconocidas.</p>
      </div>
      <div class="flex flex-col items-center">
        <i class="fas fa-headset text-4xl text-[#FFD700] mb-4"></i>
        <h4 class="font-bold mb-2">Atención personalizada</h4>
        <p class="text-gray-600 text-center">Nuestro equipo está listo para ayudarte en cada paso.</p>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h3 class="text-2xl font-bold mb-4 text-[#0F172A]">Contáctanos</h3>
    <p class="text-gray-700 mb-6">¿Tienes dudas o necesitas una cotización especial? Escríbenos y te responderemos lo antes posible.</p>
    <a href="/contacto" class="bg-[#FFD700] hover:bg-yellow-400 text-[#0F172A] font-bold px-8 py-3 rounded shadow-lg transition-all duration-200 text-lg">
      Ir a contacto
    </a>
  </div>
</section>

{{> footer}}

