{{!< ../layouts/main}}

<div class="max-w-6xl mx-auto p-8">
  <h2 class="text-3xl font-bold mb-8 text-green-700">Pedidos Completados</h2>
  <div class="overflow-x-auto rounded-lg shadow">
    <table class="min-w-full bg-white border border-gray-200">
      <thead class="bg-gradient-to-r from-green-200 to-green-400">
        <tr>
          <th class="p-4 border-b text-left text-gray-700 font-semibold"># Pedido</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Cliente</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Dirección</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Método de Pago</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Fecha</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Total</th>
          <th class="p-4 border-b text-left text-gray-700 font-semibold">Acción</th>
        </tr>
      </thead>
      <tbody>
        {{#each pedidos}}
          <tr class="hover:bg-green-50 transition">
            <td class="p-4 border-b font-bold text-green-700">#{{id}}</td>
            <td class="p-4 border-b">{{cliente.nombre}}</td>
            <td class="p-4 border-b">{{cliente.direccion}}</td>
            <td class="p-4 border-b">
              <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-800 font-semibold">{{metodo_pago}}</span>
            </td>
            <td class="p-4 border-b text-gray-600">
              {{formatDateTime fecha}}
            </td>
            <td class="p-4 border-b font-bold text-green-800">
              Bs {{total}}
            </td>
            <td class="p-4 border-b">
              <a 
                href="/admin/orders/{{id}}" 
                class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded font-semibold transition text-center"
                title="Ver detalle del pedido"
              >
                Ver detalle
              </a>
              <a 
                href="/admin/orders/{{id}}/pdf" 
                class="inline-block bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded font-semibold transition mt-4"
                target="_blank"
                >
                Descargar PDF
            </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#unless pedidos.length}}
    <div class="text-center text-green-600 mt-8 text-lg font-semibold">
      No hay pedidos completados.
    </div>
  {{/unless}}
</div>