{{!< layouts/main}}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
    :root {
        --primary: #d10000;
        --primary-dark: #a00000;
        --primary-light: #ff4d4d;
        --secondary: #333333;
        --accent: #ffd700;
        --light: #f8f8f8;
    }
    body {
        background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
        min-height: 100vh;
    }
    .header-gradient {
        background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
    }
    .sidebar {
        background: var(--secondary);
        color: white;
    }
    .sidebar a {
        color: white;
    }
    .sidebar a:hover {
        background-color: var(--primary-dark);
    }
    .btn-primary {
        background: var(--primary);
        color: white;
        transition: all 0.3s ease;
    }
    .btn-primary:hover {
        background: var(--primary-light);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(209, 0, 0, 0.3);
    }
    .footer-gradient {
        background: linear-gradient(90deg, var(--secondary) 0%, #222 100%);
    }
    .input-focus:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(209, 0, 0, 0.1);
    }
</style>

<div class="flex h-screen bg-gradient-to-r from-white to-[#f8f8f8]">
  <!-- Sidebar -->
  <div class="sidebar w-64 flex-shrink-0 shadow-lg">
    <div class="p-4 border-b border-[#FFD700]/30">
      <h1 class="text-xl font-bold text-[var(--accent)] flex items-center">
        <i class="fas fa-crown mr-2"></i> PANEL ADMINISTRATIVO
      </h1>
      <p class="text-sm text-gray-300">Bienvenido, {{nombre}}</p>
    </div>
    <nav class="p-4">
      <ul class="space-y-2">
        <li>
          <a href="/admin/orders" class="flex items-center p-3 rounded-lg hover:bg-[var(--primary-dark)] transition duration-200 {{#if active.pedidos}}bg-[var(--primary-dark)] border-l-4 border-[var(--accent)]{{/if}}">
            <i class="fas fa-clipboard-list text-[var(--accent)] mr-3"></i>
            <span>Pedidos</span>
          </a>
        </li>
        <li>
          <a href="/admin/orders_completed" class="flex items-center p-3 rounded-lg hover:bg-green-900/80 transition duration-200 {{#if active.pedidosCompletados}}bg-green-900/80 border-l-4 border-green-400{{/if}}">
            <i class="fas fa-check-circle text-green-400 mr-3"></i>
            <span>Pedidos Completados</span>
          </a>
        </li>
        <li>
          <a href="/admin/products" class="flex items-center p-3 rounded-lg hover:bg-[var(--primary-dark)] transition duration-200 {{#if active.productos}}bg-[var(--primary-dark)] border-l-4 border-[var(--accent)]{{/if}}">
            <i class="fas fa-boxes text-[var(--accent)] mr-3"></i>
            <span>Productos</span>
          </a>
        </li>
        <li>
          <a href="/admin/historial_inventario" class="flex items-center p-3 rounded-lg hover:bg-[var(--primary-dark)] transition duration-200 {{#if active.historial}}bg-[var(--primary-dark)] border-l-4 border-[var(--accent)]{{/if}}">
            <i class="fas fa-history text-[var(--accent)] mr-3"></i>
            <span>Historial Inventario</span>
          </a>
        </li>
        <li>
          <a href="/admin/reporte_semanal" class="flex items-center p-3 rounded-lg hover:bg-[var(--primary-dark)] transition duration-200 {{#if active.reporteSemanal}}bg-[var(--primary-dark)] border-l-4 border-[var(--accent)]{{/if}}">
            <i class="fas fa-chart-bar text-[var(--accent)] mr-3"></i>
            <span>Reporte Semanal</span>
          </a>
        </li>
        <li>
          <a href="/admin/employees" class="flex items-center p-3 rounded-lg hover:bg-[var(--primary-dark)] transition duration-200 {{#if active.empleados}}bg-[var(--primary-dark)] border-l-4 border-[var(--accent)]{{/if}}">
            <i class="fas fa-users text-[var(--accent)] mr-3"></i>
            <span>Empleados</span>
          </a>
        </li>
      </ul>
      <div class="mt-8 pt-4 border-t border-[var(--accent)]/20">
        <a href="/logout" class="flex items-center p-3 text-red-400 hover:bg-red-900/20 rounded-lg transition duration-200">
          <i class="fas fa-sign-out-alt mr-3"></i>
          <span>Cerrar Sesión</span>
        </a>
      </div>
    </nav>
  </div>

  <!-- Contenido principal -->
  <div class="flex-1 overflow-auto">
    <header class="header-gradient shadow-sm">
      <div class="flex items-center justify-between px-6 py-4">
        <h2 class="text-xl font-semibold text-gray-800">Principal</h2>
        <div class="flex items-center space-x-4">
          <div class="relative">
            <i class="fas fa-bell text-gray-500 hover:text-[var(--accent)] cursor-pointer"></i>
            <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
          </div>
          <div class="flex items-center">
            <span class="text-sm font-medium">{{user.nombre}}</span>
          </div>
        </div>
      </div>
    </header>

    <main class="p-6">
      <!-- Estadísticas rápidas -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500">Pedidos Hoy</p>
              <h3 class="text-2xl font-bold">{{pedidosHoy}}</h3>
            </div>
            <div class="bg-[var(--accent)]/10 p-3 rounded-full">
              <i class="fas fa-shopping-cart text-[var(--accent)]"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500">Ingresos Hoy</p>
              <h3 class="text-2xl font-bold">Bs {{ingresosHoy}}</h3>
            </div>
            <div class="bg-blue-100 p-3 rounded-full">
              <i class="fas fa-dollar-sign text-blue-500"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500">Productos</p>
              <h3 class="text-2xl font-bold">{{totalProductos}}</h3>
            </div>
            <div class="bg-green-100 p-3 rounded-full">
              <i class="fas fa-boxes text-green-500"></i>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-gray-500">Empleados</p>
              <h3 class="text-2xl font-bold">{{totalEmpleados}}</h3>
            </div>
            <div class="bg-purple-100 p-3 rounded-full">
              <i class="fas fa-users text-purple-500"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Selector de rango de días para ingresos -->
      <div class="flex items-center gap-4 mb-4">
        <label for="dias" class="font-semibold">Ver ingresos de:</label>
        <select id="dias" class="border rounded px-2 py-1">
          <option value="7" {{#if (eq diasSeleccionados 7)}}selected{{/if}}>Últimos 7 días</option>
          <option value="30" {{#if (eq diasSeleccionados 30)}}selected{{/if}}>Últimos 30 días</option>
        </select>
      </div>

      <!-- Gráficos y tablas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="font-semibold text-lg mb-4">Productos más vendidos</h3>
          <canvas id="ventasPie" width="400" height="300"></canvas>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="font-semibold text-lg mb-4">Ingresos últimos {{diasSeleccionados}} días</h3>
          <canvas id="ingresosBar" width="400" height="300"></canvas>
        </div>
      </div>
      <div class="bg-white rounded-lg shadow p-6 mt-8">
        <h3 class="font-semibold text-lg mb-6">Pedidos Recientes</h3>
        <div class="space-y-4">
          {{#each pedidosRecientes}}
          <div class="flex items-center justify-between border-b pb-3">
            <div>
              <p class="font-medium">Pedido #{{id}}</p>
              <p class="text-sm text-gray-500">{{fecha}}</p>
            </div>
            <span class="px-2 py-1 text-xs rounded-full 
              {{#if (eq estado 'completado')}}bg-green-100 text-green-800{{/if}}
              {{#if (eq estado 'pendiente')}}bg-yellow-100 text-yellow-800{{/if}}
              {{#if (eq estado 'cancelado')}}bg-red-100 text-red-800{{/if}}">
              {{estado}}
            </span>
          </div>
          {{/each}}
        </div>
        <a href="/admin/orders" class="block text-center mt-4 text-[var(--accent)] hover:underline">Ver todos</a>
      </div>
    </main>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  // Gráfico de torta: productos más vendidos
  const ctxPie = document.getElementById('ventasPie').getContext('2d');
  new Chart(ctxPie, {
    type: 'pie',
    data: {
      labels: {{json ventasPorProducto.[].nombre}},
      datasets: [{
        data: {{json ventasPorProducto.[].cantidad}},
        backgroundColor: ['#FFD700', '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0']
      }]
    }
  });

  // Gráfico de barras: ingresos últimos X días
  const ctxBar = document.getElementById('ingresosBar').getContext('2d');
  new Chart(ctxBar, {
    type: 'bar',
    data: {
      labels: {{json ingresosPorDia.[].fecha}},
      datasets: [{
        label: 'Ingresos (Bs)',
        data: {{json ingresosPorDia.[].total}},
        backgroundColor: '#FFD700'
      }]
    }
  });

  // Selector de días
  document.getElementById('dias').addEventListener('change', function() {
    window.location.search = '?dias=' + this.value;
  });
</script>