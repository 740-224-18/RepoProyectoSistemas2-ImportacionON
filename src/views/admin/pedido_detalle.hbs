{{!< ../layouts/main}}

<div class="max-w-3xl mx-auto p-8">
  <h2 class="text-2xl font-bold mb-6 text-gray-800">Detalle del Pedido #{{pedido.id}}</h2>
  <div class="mb-6 bg-white rounded shadow p-4">
    <p><span class="font-semibold">Cliente:</span> {{pedido.cliente.nombre}}</p>
    <p><span class="font-semibold">Dirección:</span> {{pedido.cliente.direccion}}</p>
    <p><span class="font-semibold">Estado:</span> {{pedido.estado}}</p>
    <p><span class="font-semibold">Fecha:</span> {{formatDateTime pedido.fecha}}</p>
    <p><span class="font-semibold">Método de pago:</span> {{pedido.metodo_pago}}</p>
  </div>
  <h3 class="text-xl font-bold mb-4 text-gray-700">Productos</h3>
  <table class="min-w-full bg-white border border-gray-200 mb-8">
    <thead class="bg-gradient-to-r from-yellow-200 to-yellow-400">
      <tr>
        <th class="p-3 border-b text-left">Producto</th>
        <th class="p-3 border-b text-left">Cantidad</th>
        <th class="p-3 border-b text-left">Precio</th>
        <th class="p-3 border-b text-left">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{#each productos}}
        <tr>
          <td class="p-3 border-b flex items-center gap-2">
            {{#if imagen}}
              <img src="/images/products/{{imagen}}" alt="{{producto_nombre}}" class="w-10 h-10 object-cover rounded" />
            {{/if}}
            {{producto_nombre}}
          </td>
          <td class="p-3 border-b">{{cantidad}}</td>
          <td class="p-3 border-b">Bs {{precio}}</td>
          <td class="p-3 border-b">Bs {{subtotal}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
  <a href="/admin/orders" class="inline-block bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded font-semibold transition">Volver a pedidos</a>
</div>