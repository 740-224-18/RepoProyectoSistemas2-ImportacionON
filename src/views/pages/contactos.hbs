<section class="relative max-w-5xl mx-auto py-16 px-6">
  <div class="bg-white/95 rounded-xl shadow-2xl p-8">
    <h2 class="text-3xl font-bold mb-2 text-[#a00000]">Contáctanos</h2>
    {{#if enviado}}
      <div class="bg-green-100 text-green-800 p-4 rounded mb-4 font-semibold">
        ¡Tu mensaje fue enviado correctamente!
      </div>
    {{/if}}
    <p class="text-lg text-gray-700 mb-8">
      ¿Tienes dudas, quieres cotizar o necesitas asesoría personalizada? Completa el formulario o utiliza cualquiera de nuestros canales de contacto.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <!-- Formulario de contacto -->
      <form action="/enviar-contacto" method="POST" class="space-y-5 text-left">
        <div>
          <label for="nombre" class="block font-semibold text-[#a00000] mb-1">Nombre</label>
          <input type="text" id="nombre" name="nombre" required class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FFD700]">
        </div>
        <div>
          <label for="correo" class="block font-semibold text-[#a00000] mb-1">Correo electrónico</label>
          <input type="email" id="correo" name="correo" required class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FFD700]">
        </div>
        <div>
          <label for="telefono" class="block font-semibold text-[#a00000] mb-1">Teléfono</label>
          <input type="text" id="telefono" name="telefono" required class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FFD700]">
        </div>
        <div>
          <label for="mensaje" class="block font-semibold text-[#a00000] mb-1">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="w-full border border-gray-300 rounded px-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#FFD700]"></textarea>
        </div>
        
        <button type="submit" class="w-full bg-[#FFD700] text-[#a00000] font-bold py-2 rounded hover:bg-yellow-400 transition">Enviar Mensaje</button>
      </form>
      <!-- Información y mapa -->
      <div class="flex flex-col justify-between h-full">
        <div class="mb-6">
          <h3 class="text-xl font-semibold text-[#FFD700] mb-2">Nuestra Ubicación</h3>
          <p class="text-gray-700 mb-2">
            Av. Cooperativa 123, Santa Cruz de la Sierra, Bolivia
          </p>
          <a href="https://www.google.com/maps/place/Cooperativa+San+Martin+de+Porres,+Agencia+la+Ramada/@-17.7934485,-63.1914114,20z/data=!4m6!3m5!1s0x93f1e817587e8261:0xed40f48e39794a84!8m2!3d-17.7933889!4d-63.1914115!16s%2Fg%2F11fx9mckbt?entry=ttu&g_ep=EgoyMDI1MDYxNy4wIKXMDSoASAFQAw%3D%3D" 
             target="_blank" 
             class="inline-flex items-center px-4 py-2 bg-[#FFD700] text-[#a00000] font-semibold rounded shadow hover:bg-yellow-400 transition mb-4">
            <i class="fas fa-map-marker-alt mr-2"></i> Ver en Google Maps
          </a>
          <iframe 
            src="https://www.google.com/maps?q=Cooperativa+San+Martin+de+Porres,+Agencia+la+Ramada,+Santa+Cruz+de+la+Sierra,+Bolivia&output=embed"
            width="100%" height="180" style="border:0; border-radius: 1rem; box-shadow: 0 2px 16px #ffd70044;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
        <div class="mt-8">
          <h3 class="text-lg font-semibold text-[#FFD700] mb-2">Horarios de atención</h3>
          <p class="text-gray-700">Lunes a Viernes: 08:00 - 20:00<br>Sábado: 08:00 - 16:00</p>
        </div>
        <div class="mt-8 items-center">
          <h3 class="text-lg font-semibold text-[#FFD700] mb-2">Otros canales</h3>
          <div class="flex space-x-4 justify-center md:justify-start">
            <a href="https://wa.me/59176262487" target="_blank" class="w-10 h-10 rounded-full bg-yellow-200 hover:bg-yellow-400 flex items-center justify-center text-[#a00000] shadow-lg transition-colors text-xl">
              <i class="fab fa-whatsapp"></i>
            </a>
            <a href="https://www.facebook.com/" target="_blank" class="w-10 h-10 rounded-full bg-yellow-200 hover:bg-yellow-400 flex items-center justify-center text-[#a00000] shadow-lg transition-colors text-xl">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="mailto:info@importadoraon.com" class="w-10 h-10 rounded-full bg-yellow-200 hover:bg-yellow-400 flex items-center justify-center text-[#a00000] shadow-lg transition-colors text-xl">
              <i class="fas fa-envelope"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>